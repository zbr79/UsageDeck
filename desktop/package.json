{
  "name": "provider-usage-widget",
  "version": "1.0.0",
  "description": "UsageDeck desktop widget",
  "author": "zbr79",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.usagedeck.widget",
    "productName": "UsageDeck",
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "../app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "../app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "UsageDeck-Setup-${version}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "zbr79",
      "repo": "UsageDeck"
    }
  }
}
