# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets (all local app data)
/data/
/data/accounts.json
/data/settings.json
/data/.api-secret
/data/usage-cache.json

# desktop widget
/desktop/node_modules/

/desktop/*.log

# agent instructions (next dev recreates AGENTS.md)
/AGENTS.md
/CLAUDE.md
/.cursorrules

# alternate build output used by tests/e2e
/.next-e2e/
/tests/.e2e-data/
/test-results/
/playwright-report/
